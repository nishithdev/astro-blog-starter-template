---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="reelsdop" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>reeldop</h1>
			<p>
				Follow us on Instagram:
				<a href="https://instagram.com/reelsdrop.co" target="_blank" rel="noopener noreferrer">
					@reelsdrop.co
				</a>
				<!-- Replace YOUR_INSTAGRAM_HANDLE with your actual Instagram username -->
			</p>
			<p>We are dropping soon!!</p>
		</main>
		<Footer />
	</body>
</html>
